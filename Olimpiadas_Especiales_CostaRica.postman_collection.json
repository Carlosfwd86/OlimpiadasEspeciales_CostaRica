							"listen": "test",
							"script": {
								"exec": [
									"var respuesta = pm.response.json();",
									"if (respuesta.token) {",
									"    pm.environment.set(\"token\", respuesta.token);",
									"    pm.globals.set(\"token\", respuesta.token);",
									"    console.log(\"Token guardado automáticamente en variables de Postman.\");",
